# Copy to .env for local dev. Host dashboards do NOT read this file — set the same keys there.
# Netlify: Site configuration > Environment variables
# Vercel: Project Settings > Environment Variables
# Cloudflare Workers:
#   Deploy command must be: npm run deploy   (or Build command: npm run build:cloudflare)
#   1) Settings > Build > Build variables and secrets
#        VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#        CLOUDFLARE_INCLUDE_PROCESS_ENV=true
#   2) Settings > Variables and Secrets (runtime) — required for first SSR paint
#        VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   wrangler uses nodejs_compat_populate_process_env so SSR reads process.env per request.

VITE_SUPABASE_URL=https://uvzfjvhcgwkmtarwzqjz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_VhkgxIRE6gTslNbh0l-qIw_2aTK_WWy
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallbacks when admin payment settings are not yet configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
PAYPAL_WEBHOOK_ID=

# Encrypts secrets stored in dq_integration_settings (32+ char random string)
INTEGRATION_ENCRYPTION_KEY=
